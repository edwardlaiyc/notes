# Normalise line endings so the tree does not show as wholly modified when
# cloned on a machine with a different core.autocrlf setting.
* text=auto eol=lf

# PowerShell is happier with CRLF on Windows.
*.ps1 text eol=crlf

# Binary assets — never touch these.
*.pdf   binary
*.png   binary
*.webp  binary
*.woff2 binary
