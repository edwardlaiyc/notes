# Compiled PDFs live in Google Drive, not here — they are large binaries that
# are regenerated on every LaTeX build, so committing them would grow history
# without bound. The site's Ecosystem cards encode this split: Drive holds the
# .pdf artifacts, GitHub holds the .tex/.md source.
*.pdf

# LaTeX build by-products.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Stray output directory from a LaTeX invocation where %OUTDIR% went unexpanded.
%OUTDIR%/

# Intermediate .tex emitted by the figure pre-renderers; publish.ps1 deletes and
# regenerates it on every run, so a committed copy would only ever be stale.
*.gen.tex

# Python bytecode from the pipeline's renderers.
__pycache__/
*.py[cod]

# The shared LaTeX → HTML/Markdown build. Kept locally: this repo publishes the
# notes and the site they produce, not the machinery. The generated .html/.md
# are committed, so GitHub Pages serves the site without it.
web-pipeline/

# AI-assistant authoring notes. Kept locally — they document the pipeline's
# quirks while writing, but they are scaffolding rather than notes, and a
# visitor to the published repo should see only the source and the site.
CLAUDE.md
AGENTS.md
.claude/

# OS / editor noise.
Thumbs.db
desktop.ini
.DS_Store
.vscode/
