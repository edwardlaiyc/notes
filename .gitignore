# Compiled PDFs live in Google Drive, not here — they are large binaries that
# are regenerated on every LaTeX build, so committing them would grow history
# without bound. The site's Ecosystem cards encode this split: Drive holds the
# .pdf artifacts, GitHub holds the .tex/.md source.
*.pdf

# LaTeX build by-products.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Stray output directory from a LaTeX invocation where %OUTDIR% went unexpanded.
%OUTDIR%/

# Intermediate .tex emitted by the figure pre-renderers; publish.ps1 deletes and
# regenerates it on every run, so a committed copy would only ever be stale.
*.gen.tex

# Python bytecode from the pipeline's renderers.
__pycache__/
*.py[cod]

# OS / editor noise.
Thumbs.db
desktop.ini
.DS_Store
.vscode/
