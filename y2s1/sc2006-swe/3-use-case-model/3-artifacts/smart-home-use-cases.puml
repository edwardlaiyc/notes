@startuml
!theme plain
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor #EEF4FB
skinparam usecaseBorderColor #2F5597
actor "Homeowner" as H
actor "Guest" as G
actor "Administrator" as A
rectangle "Smart Home Control System" {
  usecase "Grant Guest Access" as GGA
  usecase "Control Device" as CD
  usecase "Give Voice Command" as VC
  usecase "Unlock Door" as UD
  usecase "Manage Accounts" as MA
  usecase "Log In" as Login
  usecase "Clarify Command" as CC
  usecase "Check Access Window" as CAW
  usecase "Log Activity" as LA
}
actor "LLM Service\n<<external system>>" as LLM
actor "Door Lock\n<<device>>" as D
H -- GGA
H -- CD
H -- VC
G -- VC
G -- UD
A -- MA
GGA ..> Login : <<include>>
CD ..> Login : <<include>>
MA ..> Login : <<include>>
UD ..> CAW : <<include>>
UD ..> LA : <<include>>
CC .up.> VC : <<extend>>\n[command unclear]
VC -- LLM
UD -- D
@enduml
