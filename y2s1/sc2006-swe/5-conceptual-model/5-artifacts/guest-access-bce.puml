@startuml
!theme plain
!pragma layout smetana
skinparam defaultFontName Arial
actor "Guest" as GA
boundary "UnlockDoorUI" as UI
control "UnlockDoorController" as C
boundary "DoorLockInterface" as DLI
entity "AccessGrant" as AG
entity "GuestAccount" as GE
entity "Door" as DR
entity "ActivityLog" as LOG
GA ..> UI : <<call>>
UI ..> C : <<call>>
C ..> AG : <<read>>
C ..> LOG : <<write>>
C ..> DLI : <<call>>
GE "1" -- "*" AG : holds
AG "*" -- "1" DR : for
DR "1" -- "*" LOG : records
@enduml
