@startuml
!theme plain
skinparam defaultFontName Arial
|Guest|
start
:Say "unlock front door";
|Voice Assistant (LLM)|
:Transcribe speech;
:Interpret request;
if (Command clear?) then (no)
  :Ask clarifying question;
  |Guest|
  :Answer question;
  |Voice Assistant (LLM)|
else (yes)
endif
|SHCS|
:Check guest access window;
if (Inside window?) then (no)
  :Deny request;
  :Log denied attempt;
else (yes)
  :Send unlock signal;
  |Door Lock|
  :Unlock door;
  |SHCS|
  :Log unlock event;
  :Confirm to guest;
endif
|Guest|
stop
@enduml
