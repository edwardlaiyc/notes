@startuml
!theme plain
!pragma layout smetana
skinparam defaultFontName Arial
hide empty description
[*] --> OFF
OFF --> WarmUp : ON button pressed
state "WARM-UP" as WarmUp
WarmUp : entry / beep
WarmUp : do / blink red light
WarmUp : exit / turn light green
WarmUp --> ON : warm-up finished
state ON {
  [*] --> PC
  PC --> LAPTOP : LAPTOP button pressed
  LAPTOP --> PC : PC button pressed
}
ON --> OFF : OFF button pressed\n[light not blinking]
@enduml
