@startuml
!theme plain
!pragma layout smetana
skinparam defaultFontName Arial
left to right direction
actor Actor
rectangle "Boundary\n(screens, device and\nexternal-system interfaces)" as B #E8F1FB
rectangle "Control\n(use case logic)" as C #FFF4DC
rectangle "Entity\n(stored information)" as E #E9F7EC
Actor --> B : uses
B --> C : calls
C --> C : calls
C --> E : reads / writes
E --> E : associations
B -[hidden]-> E
@enduml
