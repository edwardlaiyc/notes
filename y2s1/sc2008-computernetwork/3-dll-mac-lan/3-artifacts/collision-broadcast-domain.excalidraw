    {
      "id": "0wMLBX3o7cfbeYPthf-Ke",
      "type": "text",
      "x": 766.9865595645375,
      "y": 838.1482721260513,
      "width": 633.8995361328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
