      "isDeleted": false,
      "boundElements": null,
      "updated": 1788623527508,
      "link": null,
      "locked": false,
      "text": "Broadcast domain:\nOnly L3 devices (Routers) block and terminate broadcast frames.\nL1 (hubs) and L2 devices (bridges, switches) forward broadcasts \nout of every connected port.  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rq6E-1JIBN7zNPn9IYEHc",
      "originalText": "Broadcast domain:\nOnly L3 devices (Routers) block and terminate broadcast frames.\nL1 (hubs) and L2 devices (bridges, switches) forward broadcasts out of every connected port.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
